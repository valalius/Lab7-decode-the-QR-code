def scanner(qrcode):
    # Координати для зигзагоподібного читання 76 біт корисних даних
    path = [
        (20,20), (20,19), (19,20), (19,19), (18,20), (18,19), (17,20), (17,19),
        (16,20), (16,19), (15,20), (15,19), (14,20), (14,19), (13,20), (13,19),
        (12,20), (12,19), (11,20), (11,19), (10,20), (10,19), (9,20),  (9,19),
        
        # Ннаступний подвійний стовпець вниз
        (9,18),  (9,17),  (10,18), (10,17), (11,18), (11,17), (12,18), (12,17),
        (13,18), (13,17), (14,18), (14,17), (15,18), (15,17), (16,18), (16,17),
        (17,18), (17,17), (18,18), (18,17), (19,18), (19,17), (20,18), (20,17),
        
        # Наступний подвійний стовпець вгору
        (20,16), (20,15), (19,16), (19,15), (18,16), (18,15), (17,16), (17,15),
        (16,16), (16,15), (15,16), (15,15), (14,16), (14,15), (13,16), (13,15),
        (12,16), (12,15), (11,16), (11,15), (10,16), (10,15), (9,16),  (9,15),
        
        # Останні 4 біти для досягнення 76 (вниз)
        (9,14),  (9,13),  (10,14), (10,13)
    ]
    
    bits = ""
    for r, c in path:
        bit = qrcode[r][c]
        
        if (r + c) % 2 == 0:
            bit ^= 1 
            
        bits += str(bit)
        
        if len(bits) == 76:
            break
            
    length_bits = bits[4:12]
    word_length = int(length_bits, 2)
    
    message = ""
    data_start = 12
    for i in range(word_length):
        char_bits = bits[data_start + i*8 : data_start + (i+1)*8]
        char_code = int(char_bits, 2)
        message += chr(char_code)
        
    return message
